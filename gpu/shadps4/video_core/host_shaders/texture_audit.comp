// Opt-in diagnostic: fetch through the actual bound view, at every mip level.
#version 450
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0,std430) writeonly buffer Results { vec4 values[]; };
layout(set=0,binding=1) uniform sampler2D source_image;
void main() {
    uvec2 cell=gl_LocalInvocationID.xy;
    int mip=int(gl_WorkGroupID.z);
    ivec2 extent=textureSize(source_image,mip);
    ivec2 pixel=ivec2(cell)*(extent-1)/15;
    values[mip*256+cell.y*16+cell.x]=texelFetch(source_image,pixel,mip);
}
