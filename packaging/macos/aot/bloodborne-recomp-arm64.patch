+/* Only emitted for a side-effect-free memory comparison loop. Keep short waits
+ * spinning; an opt-in one-microsecond sleep bounds sustained polling work. A
+ * wakeup always re-reads guest memory and recomputes the architectural flags.
+ * Host scheduling may delay a wakeup; this is not a simulated guest timer. */
+static inline void rc_poll_wait(unsigned *spins) {
+    if (++*spins < 256) return;
+    *spins = 0;
+    const char *enabled = getenv("BB_RECOMP_POLL_WAIT");
+    if (!enabled || enabled[0] != '1') return;
+    const int saved_errno = errno;
+    const struct timespec delay = {0, 1000};
+    (void)nanosleep(&delay, NULL);
+    errno = saved_errno;
+}
