+ * does not call interp_vec.c (which lacks BQ/WQ), nor use the generator's typed
+ * vector casts: copy each source element and fill its remaining bytes. */
+static int reference_widen(BbCpu *cpu, const BbInsn *in) {
+    int from, to, sign;
+    switch (in->mnemonic) {
+#define WIDEN(S, F, T, N) case ZYDIS_MNEMONIC_PMOV##S##N: case ZYDIS_MNEMONIC_VPMOV##S##N: from=F; to=T; sign=(#S[0]=='S'); break;
+    WIDEN(ZX,1,2,BW) WIDEN(ZX,1,4,BD) WIDEN(ZX,1,8,BQ)
+    WIDEN(ZX,2,4,WD) WIDEN(ZX,2,8,WQ) WIDEN(ZX,4,8,DQ)
+    WIDEN(SX,1,2,BW) WIDEN(SX,1,4,BD) WIDEN(SX,1,8,BQ)
+    WIDEN(SX,2,4,WD) WIDEN(SX,2,8,WQ) WIDEN(SX,4,8,DQ)
+#undef WIDEN
+    default: return 0;
+    }
+    const int width=in->op[0].size;
+    const BbOp *src=&in->op[1];
+    uint8_t input[16];
+    const void *at=src->type==OP_MEM ? (void*)(uintptr_t)bbcpu_addr(cpu,in,src) : cpu->v[src->reg].b;
+    memcpy(input,at,(size_t)(width/to*from));
+    uint8_t *dst=cpu->v[in->op[0].reg].b;
+    for(int i=0;i<width/to;++i) {
+        const uint8_t *element=input+i*from;
+        memset(dst+i*to,sign && (element[from-1]&0x80) ? 0xff : 0,(size_t)to);
+        memcpy(dst+i*to,element,(size_t)from);
+    }
+    if(in->vex && width==16) memset(dst+16,0,16);
+    return 1;
+}
