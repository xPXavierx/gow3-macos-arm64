+/* Byte-oriented reference for SSSE3 sign control and rounded multiply.
+ * These forms are absent from the upstream interpreter. Specification reference:
+ * https://clang.llvm.org/doxygen/tmmintrin_8h.html (no implementation copied).
+ * Multiplication uses int64 arithmetic and floor division, independently of the
+ * generator's int32 arithmetic shift. Both sources are captured before alias writes. */
+static int reference_sign(BbCpu *cpu,const BbInsn *in) {
+    int size,multiply=0;
+    switch(in->mnemonic) {
+    case ZYDIS_MNEMONIC_PSIGNB: case ZYDIS_MNEMONIC_VPSIGNB: size=1;break;
+    case ZYDIS_MNEMONIC_PSIGNW: case ZYDIS_MNEMONIC_VPSIGNW: size=2;break;
+    case ZYDIS_MNEMONIC_PSIGND: case ZYDIS_MNEMONIC_VPSIGND: size=4;break;
+    case ZYDIS_MNEMONIC_PMULHRSW: case ZYDIS_MNEMONIC_VPMULHRSW: size=2;multiply=1;break;
+    default:return 0;
+    }
+    const int width=in->op[0].size;
+    uint8_t src[2][32];
+    for(int j=0;j<2;++j) {
+        const BbOp *op=&in->op[j+(in->vex ? 1 : 0)];
+        const void *at=op->type==OP_MEM ? (void*)(uintptr_t)bbcpu_addr(cpu,in,op) : cpu->v[op->reg].b;
+        memcpy(src[j],at,(size_t)width);
+    }
+    uint8_t *dst=cpu->v[in->op[0].reg].b;
+    for(int i=0;i<width;i+=size) {
+        uint32_t a=0,b=0;
+        for(int j=0;j<size;++j) { a|=(uint32_t)src[0][i+j]<<(8*j); b|=(uint32_t)src[1][i+j]<<(8*j); }
+        uint32_t v;
+        if(multiply) {
+            const int64_t x=a<32768 ? a : (int64_t)a-65536, y=b<32768 ? b : (int64_t)b-65536;
+            const int64_t scaled=x*y+16384;
+            v=(uint32_t)(scaled<0 ? -((-scaled+32767)/32768) : scaled/32768);
+        } else v=!b ? 0 : src[1][i+size-1]&128 ? (~a+1u) : a;
+        for(int j=0;j<size;++j) dst[i+j]=(uint8_t)(v>>(8*j));
+    }
+    if(in->vex && width==16) memset(dst+16,0,16);
+    return 1;
+}
